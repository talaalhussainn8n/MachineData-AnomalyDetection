{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Monitor": "Data Source=machinemonitor.db"
  },
  "Monitor": {
    "MqttHost": "",
    "MqttPort": 1883,
    "SimulationEnabled": true,
    "SimulatedMachines": 3,
    "SimulationIntervalMs": 1000
  }
}
